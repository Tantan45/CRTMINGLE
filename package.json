{
  "name": "crtmingle",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymous student chat with safety moderation and reporting",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npm run build:css && node --watch src/server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css",
    "admin:hash": "node scripts/hash-admin-code.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "compression": "^1.7.4",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "sanitize-html": "^2.14.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
